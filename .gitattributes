# Normalize all text files to LF in the repository and working trees.
# Prevents CRLF/LF churn between Windows and Unix contributors/tools.
* text=auto eol=lf

# Windows-specific scripts keep CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf
*.cmd text eol=crlf

# Binary assets (never normalize)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pdf binary
*.zip binary
